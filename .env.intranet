# Youth360 — Intranet Deployment Environment
# Copy this to .env and fill in the two required secrets before starting.

# Database (do not change unless you modify docker-compose.intranet.yml)
DATABASE_URL=postgresql://youth360:youth360intranet@postgres:5432/youth360
DB_PASSWORD=youth360intranet

# Redis
REDIS_URL=redis://redis:6379

# ---- REQUIRED: generate these before first run ----
# SESSION_SECRET: any random 64-character string
#   PowerShell: -join ((65..90)+(97..122)+(48..57) | Get-Random -Count 64 | %{[char]$_})
SESSION_SECRET=CHANGE_ME_64_CHAR_RANDOM_STRING

# NRIC_ENCRYPTION_KEY: exactly 32 hex bytes (64 hex chars)
#   PowerShell: -join ((0..255) | Get-Random -Count 32 | %{'{0:x2}' -f $_})
NRIC_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS

# Local AI (Ollama) — no internet required
# Available models: qwen2.5:3b (recommended), phi3:mini (faster, lighter)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b

# Leave all cloud AI keys blank — Ollama handles AI in intranet mode
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=

NODE_ENV=production
